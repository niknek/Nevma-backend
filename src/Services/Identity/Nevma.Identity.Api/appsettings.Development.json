{
  "Authentication": {
    "SeedDevelopmentClient": true,
    "MobileRedirectUri": "com.nevma.app:/oauth/callback",
    "MobilePostLogoutRedirectUri": "com.nevma.app:/oauth/logout-callback",
    "AllowedExternalReturnUrls": [
      "http://localhost:5173/",
      "http://127.0.0.1:5173/",
      "com.nevma.app://auth/callback"
    ]
  },
  "EmailDelivery": {
    "EmailConfirmationRedirectUri": "https://nevma-frontend.onrender.com/account/confirm-email"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
