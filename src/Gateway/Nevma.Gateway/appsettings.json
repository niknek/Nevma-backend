{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/identity" },
          { "RequestHeaderOriginalHost": "true" }
        ]
      },
      "identity-google-callback": {
        "ClusterId": "identity",
        "Match": { "Path": "/signin-google" },
        "Transforms": [{ "RequestHeaderOriginalHost": "true" }]
      },
      "identity-facebook-callback": {
        "ClusterId": "identity",
        "Match": { "Path": "/signin-facebook" },
        "Transforms": [{ "RequestHeaderOriginalHost": "true" }]
      },
      "planning": {
        "ClusterId": "planning",
        "Match": { "Path": "/planning/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/planning" }]
      },
      "messaging": {
        "ClusterId": "messaging",
        "Match": { "Path": "/messaging/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/messaging" }]
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/notifications" }]
      },
      "files": {
        "ClusterId": "files",
        "Match": { "Path": "/files/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/files" }]
      },
      "commands": {
        "ClusterId": "commands",
        "Match": { "Path": "/commands/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/commands" }]
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "primary": { "Address": "http://localhost:5016" } } },
      "planning": { "Destinations": { "primary": { "Address": "http://localhost:5276" } } },
      "messaging": { "Destinations": { "primary": { "Address": "http://localhost:5085" } } },
      "notifications": { "Destinations": { "primary": { "Address": "http://localhost:5095" } } },
      "files": { "Destinations": { "primary": { "Address": "http://localhost:5106" } } },
      "commands": { "Destinations": { "primary": { "Address": "http://localhost:5116" } } }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7000",
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:8081",
      "http://127.0.0.1:8081"
    ]
  },
  "OpenTelemetry": {
    "Otlp": { "Enabled": false, "Endpoint": "http://localhost:4317" }
  },
  "Authentication": { "Issuer": "https://localhost:7293/" },
  "Services": {
    "Identity": "https://localhost:7293",
    "Planning": "http://localhost:5276",
    "Notifications": "http://localhost:5095",
    "Messaging": "http://localhost:5085",
    "Files": "http://localhost:5106"
  },
  "AllowedHosts": "*"
}
